# ── Backend environment variables ─────────────────────────────────────────────
# Set these in Koyeb (or Render) dashboard → Service → Environment Variables

# Your Groq API key (already hardcoded as fallback, but better to set here)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Frontend environment variables ────────────────────────────────────────────
# Set these in Netlify dashboard → Site → Environment Variables

# Public URL of your deployed backend (no trailing slash)
# Example: https://jarvis-backend-xxxx.koyeb.app/api
VITE_API_URL=https://YOUR-KOYEB-APP.koyeb.app/api
